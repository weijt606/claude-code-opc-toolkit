# cc-pilot dev profile — allowed tools
# Daily development. Includes everything in safe.allow PLUS reversible
# mutations: file edits, builds, tests, package management, recoverable git.
# Edit this file to extend the dev profile (PRs welcome).

# Everything from safe is allowed (read-only ops)
Read
Glob
Grep
Bash(ls*)
Bash(cat *)
Bash(head *)
Bash(tail *)
Bash(wc *)
Bash(file *)
Bash(stat *)
Bash(du *)
Bash(df *)
Bash(pwd)
Bash(which *)
Bash(type *)
Bash(env)
Bash(date)
Bash(uname *)
Bash(grep *)
Bash(rg *)
Bash(find *)
Bash(awk *)
Bash(sed -n*)
Bash(jq *)
Bash(sort *)
Bash(uniq *)
Bash(tr *)
Bash(cut *)
Bash(git status*)
Bash(git diff*)
Bash(git log*)
Bash(git show*)
Bash(git branch*)
Bash(git ls-files*)
Bash(git ls-tree*)
Bash(git remote*)
Bash(git config --get*)
Bash(git rev-parse*)
Bash(git describe*)
Bash(git blame*)

# File mutations (Edit/Write are recoverable via git)
Edit
Write

# Sed/awk in-place are reversible if files are tracked
Bash(sed -i*)

# Filesystem mutations within home (recoverable)
Bash(mkdir -p*)
Bash(touch *)
Bash(cp *)
Bash(mv *)
Bash(chmod +x*)

