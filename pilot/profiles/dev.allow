# Reversible git (commits/branches; uncommitted edits live in worktree)
Bash(git add*)
Bash(git commit*)
Bash(git stash*)
Bash(git checkout *)
Bash(git switch *)
Bash(git pull*)
Bash(git fetch*)
Bash(git merge *)
Bash(git rebase *)
Bash(git tag *)
Bash(git cherry-pick *)
Bash(git apply *)
Bash(git restore *)
Bash(git reflog*)

# Plain `git push` (without --force) — pushing is recoverable on the remote
Bash(git push)
Bash(git push origin*)
Bash(git push --set-upstream*)

# GitHub CLI (read + safe mutations)
Bash(gh status*)
Bash(gh repo view*)
Bash(gh pr list*)
Bash(gh pr view*)
Bash(gh pr diff*)
Bash(gh issue list*)
Bash(gh issue view*)
Bash(gh api *)
Bash(gh auth status*)
